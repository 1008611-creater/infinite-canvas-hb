# ===== Agnes 视频模型 =====
AGNES_API_KEY=sk-xxxxxxxx
AGNES_BASE_URL=https://apihub.agnes-ai.com

# ===== 代理服务 =====
PROXY_PORT=8787
# 本地图片上传图床：
#   auto（默认，按顺序回退 litterbox → uguu → tmpfiles → catbox）
#   litterbox | uguu | tmpfiles | catbox（锁定单个）| none（仅接受公网 URL）
# 说明：catbox.moe 匿名上传已被封（返回 Invalid uploader），默认改用 litterbox
#      （catbox 临时通道，返回 litter.catbox.moe 真直链，72 小时有效）。
AGENT_UPLOAD=auto
# 自定义图床（选填）：填了就优先用它，失败再回退上面的内置图床
# UPLOAD_ENDPOINT=https://your-image-host.example/api/upload
# UPLOAD_FILE_FIELD=fileToUpload
# UPLOAD_FIELDS={"reqtype":"fileupload"}
# 天宫漫剧默认竖屏 / 拉满时长
DEFAULT_AR=9:16
DEFAULT_SECONDS=12

# ===== 后续扩展位（暂未接入，填了也不影响 agnes） =====
