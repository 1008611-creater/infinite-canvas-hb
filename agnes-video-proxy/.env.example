# ===== Agnes 视频模型 =====
AGNES_API_KEY=sk-xxxxxxxx
AGNES_BASE_URL=https://apihub.agnes-ai.com

# ===== 代理服务 =====
PROXY_PORT=8787
# 访问令牌（公网部署必填）：请求必须带 Authorization: Bearer <这个值>，否则 401。
# 留空 = 不校验（本机开发）。服务器部署时填一个随机串，并把它作为 VITE_AGNES_API_KEY 注入前端构建。
# PROXY_ACCESS_TOKEN=

# ===== 站点门禁（公网部署必填，替代 Basic Auth）=====
# 只输密码、不要用户名：登录页 POST /auth 提交密码，校验通过才下发 canvas_auth cookie。
# 密码只存在服务端，不会出现在前端源码里。
# SITE_PASSWORD=你的站点密码
# 登录凭证（「已登录」的 cookie 值）。首次部署由 publish.sh 自动生成并写到这里，
# 之后固定不变——每次部署都换的话，已登录的用户会被迫重新登录。
# AUTH_COOKIE=

# 本地图片上传图床：
#   auto（默认，按顺序回退 litterbox → uguu → tmpfiles → catbox）
#   litterbox | uguu | tmpfiles | catbox（锁定单个）| none（仅接受公网 URL）
# 说明：catbox.moe 匿名上传已被封（返回 Invalid uploader），默认改用 litterbox
#      （catbox 临时通道，返回 litter.catbox.moe 真直链，72 小时有效）。
AGENT_UPLOAD=auto
# 自定义图床（选填）：填了就优先用它，失败再回退上面的内置图床
# UPLOAD_ENDPOINT=https://your-image-host.example/api/upload
# UPLOAD_FILE_FIELD=fileToUpload
# UPLOAD_FIELDS={"reqtype":"fileupload"}
# 天宫漫剧默认竖屏 / 拉满时长
DEFAULT_AR=9:16
DEFAULT_SECONDS=12

# ===== 后续扩展位（暂未接入，填了也不影响 agnes） =====
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimax.io
# SEEDANCE_API_KEY=
# SEEDANCE_BASE_URL=
