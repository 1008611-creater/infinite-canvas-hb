{
    "name": "infinite-canvas",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --host 0.0.0.0 --port 3000",
        "build": "vite build",
        "typecheck": "tsc --noEmit",
        "test:contracts": "node --experimental-strip-types --test src/lib/canvas/canvas-chain.test.ts src/lib/canvas/canvas-generation-status.test.ts src/lib/canvas/canvas-status-labels.test.ts src/services/api/video-request-headers.test.ts src/services/api/video-result-validation.test.ts ../agnes-video-proxy/idempotency-store.test.js ../agnes-video-proxy/request-fingerprint.test.js ../agnes-video-proxy/proxy-integration.test.js",
        "format:check:slice": "prettier --check src/lib/canvas/canvas-chain.ts src/lib/canvas/canvas-chain.test.ts src/lib/canvas/canvas-generation-status.ts src/lib/canvas/canvas-generation-status.test.ts src/lib/canvas/canvas-status-labels.ts src/lib/canvas/canvas-status-labels.test.ts src/services/api/video-request-headers.ts src/services/api/video-request-headers.test.ts src/services/api/video-result-validation.ts src/services/api/video-result-validation.test.ts ../agnes-video-proxy/idempotency-store.js ../agnes-video-proxy/idempotency-store.test.js ../agnes-video-proxy/request-fingerprint.js ../agnes-video-proxy/request-fingerprint.test.js ../agnes-video-proxy/proxy-integration.test.js",
        "verify": "npm run typecheck && npm run format:check:slice && npm run test:contracts && npm run build",
        "start": "vite preview --host 0.0.0.0 --port 3000",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@ant-design/icons": "^6.1.1",
        "@ant-design/pro-components": "3.0.0-beta.3",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/lang-json": "^6.0.2",
        "@tanstack/react-query": "^5.100.9",
        "@uiw/react-codemirror": "^4.25.9",
        "antd": "^6.4.2",
        "axios": "^1.16.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "copy-to-clipboard": "^4.0.2",
        "dayjs": "^1.11.20",
        "fflate": "^0.8.3",
        "file-saver": "^2.0.5",
        "i18next": "^26.3.6",
        "localforage": "^1.10.0",
        "lucide-react": "^1.16.0",
        "motion": "^12.38.0",
        "nanoid": "^5.1.11",
        "radix-ui": "^1.4.3",
        "react": "19.2.5",
        "react-dom": "19.2.5",
        "react-i18next": "^17.0.11",
        "react-router": "^7.12.0",
        "react-router-dom": "^7.12.0",
        "shadcn": "^4.7.0",
        "streamdown": "^2.5.0",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4",
        "tw-animate-css": "^1.4.0",
        "zustand": "^5.0.12"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/file-saver": "^2.0.7",
        "@types/node": "^20",
        "@types/react": "19.1.12",
        "@types/react-dom": "19.1.9",
        "@vitejs/plugin-react": "^5.2.0",
        "prettier": "^3.8.3",
        "typescript": "^5",
        "vite": "^7.3.0"
    }
}
